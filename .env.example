# Network Topology Plugin Environment Configuration
# Copy this file to .env and update values for your environment

# =============================================================================
# Service Ports
# =============================================================================
TOPOLOGY_PORT=9004

# =============================================================================
# Directory Paths
# =============================================================================
# Topology state uses the Compose-managed "topology-data" volume by default.
# To store it in a host directory instead, set an absolute path locally.
# Keep the real value in .env, which is ignored by Git.
# TOPOLOGY_DATA_HOST_PATH=/absolute/path/to/topology-data

# Host directory shared with topology agent containers for persistent outputs.
# Keep machine-specific paths in the untracked .env.
# OUTPUTS_HOST_PATH=/absolute/path/to/outputs

# =============================================================================
# Plugin Configuration
# =============================================================================
PLUGIN_ID=network-topology
PLUGIN_VERSION=2.0.0

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO

# =============================================================================
# Optional: LLM Configuration
# =============================================================================
# Dashboard LLM URL for data generation
# DASHBOARD_LLM_URL=http://dashboard/api/llm/chat

# OpenCode API Key
OPENCODE_API_KEY=YOUR_OPENCODE_API_KEY_HERE

# Full LLM URL and Model
LLM_URL=https://llm.ai.e-infra.cz/v1
LLM_MODEL=glm-5.2

# Agent scripts host path
# AGENTS_HOST_PATH=/agent-scripts
